# Transfer Efecty v2 — variables de entorno
# Copiar a .env.local para desarrollo (Next.js carga .env.local automáticamente
# y ese archivo ya está en .gitignore). En Vercel, cargar estas mismas claves
# en Project Settings → Environment Variables (nunca committear valores reales).

# Postgres — Neon / Vercel Postgres. Prisma necesita el modo "pooled" para
# runtime serverless y una conexión directa para migraciones.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Sesión (JWT firmado, ver src/lib/auth/session.ts). Generar con:
#   openssl rand -base64 32
SESSION_SECRET=""
SESSION_TTL_HOURS=12

# Cifrado de datos sensibles en reposo (ej. mfa_secret). Generar con:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=""

APP_URL="http://localhost:3000"
APP_ENV="development"

# Almacenamiento de archivos KYC (elegir uno; ver docs/ARQUITECTURA.md)
# BLOB_READ_WRITE_TOKEN=""          # Vercel Blob
# R2_ACCOUNT_ID=""                  # Cloudflare R2 (alternativa)
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

MAIL_FROM="support@transferefecty.com"

# Correo transaccional (reset de contraseña, etc.) — src/lib/mail.ts.
# Sin esta key, el envío hace console.warn en vez de mandar de verdad.
# RESEND_API_KEY=""

# Rate limiting (Upstash Redis) — opcional en desarrollo
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
